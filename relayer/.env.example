ARC_RPC_URL=https://rpc.testnet.arc.network
FACTORY_ADDRESS=<router-backed-factory-address>
RESOLUTION_ROUTER_ADDRESS=<deployed-resolution-router-address>
CONFIRMATION_DEPTH=12
REORG_LOOKBACK_BLOCKS=48
RELAYER_COORDINATION_MODE=shared-sqlite
# Distributed mode requires the commercial API coordination endpoints.
# COMMERCIAL_REGISTRY_URL=https://commercial-api.example
# COMMERCIAL_REGISTRY_INTERNAL_TOKEN=<shared-internal-token>
# RELAYER_INSTANCE_ID=<stable-host-instance-id>
GATEWAY_API_BASE_URL=https://gateway-api-testnet.circle.com
RELAYER_PRIVATE_KEY=<server-side relayer signing key>
SQLITE_PATH=/data/relayer.db
# Railway supplies PORT. Set this only when overriding the platform port.
# RELAYER_PORT=10000

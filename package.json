{
  "name": "arc-trade-escrow-relayer",
  "version": "1.0.0",
  "private": true,
  "description": "Circle Gateway authorization relayer for DocumentaryTradeEscrow",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --env-file-if-exists=.env --import tsx --watch relayer/src/index.ts",
    "test": "node --import tsx --test relayer/test/*.test.ts",
    "test:watch": "node --import tsx --test --watch relayer/test/*.test.ts"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "better-sqlite3": "^11.9.1",
    "ethers": "^6.14.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
